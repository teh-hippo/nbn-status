{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>teh-hippo/common-repo-configs//renovate/default.json5"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "all non-major"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "all major"
    },
    {
      "description": "Hold azure-functions on the 2.x line. 3.x has not been verified on this app's Flex Consumption + Python 3.13 stack.",
      "matchPackageNames": [
        "azure-functions"
      ],
      "allowedVersions": "<3.0.0"
    },
    {
      "description": "Hold Python on the 3.13 family. 3.14 is currently Preview on Azure Functions and Flex remote build does not support it yet.",
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.14.0"
    },
    {
      "description": "Block actions/setup-python python-version from jumping past 3.13.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.14.0"
    }
  ]
}
