# Copy to terraform.tfvars (gitignored) and fill in the real values.
# These are Azure identifiers and resource names, not secrets, but they are
# kept out of version control. The sensitive runtime values
# (microsoft_provider_authentication_secret, ntfy_topic, nbn_addresses) are
# supplied separately via TF_VAR_* env vars (see load-secrets.sh).

subscription_id         = "00000000-0000-0000-0000-000000000000"
tenant_id               = "11111111-1111-1111-1111-111111111111"
resource_group_name     = "example-rg"
app_name                = "example-app"
storage_account_name    = "examplestore"
app_insights_name       = "example-insights"
easy_auth_app_object_id = "22222222-2222-2222-2222-222222222222"
easy_auth_sp_object_id  = "33333333-3333-3333-3333-333333333333"
easy_auth_client_id     = "44444444-4444-4444-4444-444444444444"
